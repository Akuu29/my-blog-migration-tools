/* ---- Categories ---- */
Table categories {
  id serial [pk]
  public_id uuid [unique, default: "uuid_generate_v4()"]
  name varchar(60) [not null]
  slug varchar
  user_id int [not null]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_categories_updated_at"
    }
  ]

  indexes {
    (user_id, name) [
      unique,
      name: "uq_categories_user_name"
    ]
    (user_id, slug) [
      unique,
      name: "uq_categories_user_slug"
    ]
  }
}
Ref: categories.user_id > users.id [delete: cascade]

/* ---- Tags ---- */
Table tags {
  id serial [pk]
  public_id uuid [unique, default: "uuid_generate_v4()"]
  name varchar(30) [not null]
  user_id int [not null]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_tags_updated_at"
    }
  ]

  indexes {
    (user_id, name) [
      unique,
      name: "uq_tags_user_name"
    ]
  }
}
Ref: tags.user_id > users.id [delete: cascade]

/* ---- Article Tags ---- */
Table article_tags {
  article_id int [pk, not null]
  tag_id int [pk, not null]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_article_tags_updated_at"
    }
  ]

  indexes {
    (tag_id, article_id) [
      name: "idx_article_tags_tag_article"
    ]
    (article_id, tag_id) [
      name: "idx_article_tags_article_tags"
    ]
  }
}
Ref: article_tags.article_id > articles.id [delete: cascade]
Ref: article_tags.tag_id > tags.id [delete: cascade]

/* ---- Comments ---- */
Table comments {
  id serial [pk]
  public_id uuid [unique, default: "uuid_generate_v4()"]
  body text [not null]
  user_id int [default: null]
  user_name varchar [default: null]
  is_active boolean [default: true]
  article_id int [not null]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_comments_updated_at"
    }
  ]

  indexes {
    (article_id) [
      name: "idx_comments_article_id"
    ]
  }
}
Ref: comments.user_id > users.id [delete: set null]
Ref: comments.article_id > articles.id [delete: cascade]

/* ---- Storage Types ---- */
Table storage_types {
  id serial [pk]
  name varchar [
    not null,
    unique,
    Note: {
      "Seeds:
        - 1: database
        - 2: custom
        - 3: s3"
    }
  ]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_storage_types_updated_at"
    }
  ]
}

/* ---- Images ---- */
Table images {
  id serial [pk]
  public_id uuid [unique, default: "uuid_generate_v4()"]
  name varchar [not null]
  mime_type varchar [not null]
  data bytea [default: null]
  url text [default: null]
  storage_type_id int [not null, default: 1]
  article_id int [not null]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_images_updated_at"
    }
  ]

  Note: {
    "Check: ( (data IS NOT NULL AND url IS NULL) OR (data IS NULL AND url IS NOT NULL) )"
  }
}
Ref: images.article_id > articles.id [delete: cascade]
Ref: images.storage_type_id > storage_types.id [delete: set null]
