Project my_blog_db {
  database_type: "PostgreSQL"
  Note: {
    """
    required extensions:
      - uuid-ossp
    """
  }
}

/* ---- Triggers ---- */
Note: {
  """
  updated_at_trigger:
    description: update updated_at column to current timestamp when row is updated
  """
}

/* ---- Users ---- */
Enum user_role {
  admin
  user
}

Table users {
  id serial [pk]
  public_id uuid [unique, default: "uuid_generate_v4()"]
  name varchar(45) [not null]
  role user_role [not null, default: "user"]
  is_active boolean [default: true]
  last_login_at timestamptz [default: "current_timestamp"]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_users_updated_at"
    }
  ]
}

/* ---- Identity Providers ---- */
Table identity_providers {
  id serial [pk]
  name varchar [
    not null,
    unique,
    Note: {
      "Seeds:
        - 1: firebase
        - 2: auth0
        - 3: cognito
        - 4: okta
        - 5: github
        - 6: google_cloud_identity
        - 7: custom"
    }
  ]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [default: "current_timestamp"]
}

/* ---- User Identities ---- */
Table user_identities {
  id serial [pk]
  user_id int [not null]
  provider_id int [not null]
  provider_user_id varchar [not null]
  provider_email_ciphertext bytea [not null]
  provider_email_cipher_nonce bytea [not null]
  provider_email_cipher_meta jsonb [
    not null,
    Note: {
      "Example: {'alg': 'aes-256-gcm', 'key_ver': 1}"
    }
  ]
  provider_email_hash varchar(128) [not null]
  provider_email_verified boolean [default: false]
  is_primary boolean [default: false]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_identity_providers_updated_at"
    }
  ]

  indexes {
    (user_id) [
      unique,
      name: "idx_user_identities_user_id",
      Note: {
        "WHERE is_primary"
      }
    ]
    (provider_id, provider_user_id) [
      unique,
      name: "uq_user_identities_provider_user_id"
    ]
    (provider_email_hash) [
      name: "idx_user_identities_provider_email_hash"
    ]
  }
}
Ref: user_identities.user_id > users.id [delete: cascade]
Ref: user_identities.provider_id > identity_providers.id [delete: cascade]

/* ---- Refresh Tokens ---- */
Table refresh_tokens {
  id serial [pk]
  user_id int [not null]
  token_hash varchar(128) [not null]
  expires_at timestamptz [not null]
  revoked_reason varchar [
    default: null
    Note: {
      "Example: 'logout', 'revoke', 'admin_force'"
    }
  ]
  last_used_at timestamptz [default: null]
  revoked_at timestamptz [default: null]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_refresh_tokens_updated_at"
    }
  ]
}
Ref: refresh_tokens.user_id > users.id [delete: cascade]

/* ---- Articles ---- */
Enum article_status {
  draft
  private
  published
  deleted
}

Table articles {
  id serial [pk]
  public_id uuid [unique, default: "uuid_generate_v4()"]
  title varchar
  slug varchar
  body text
  status article_status [default: "draft"]
  user_id int [not null]
  category_id int [default: null]
  first_published_at timestamptz [default: null]
  created_at timestamptz [default: "current_timestamp"]
  updated_at timestamptz [
    default: "current_timestamp"
    Note: {
      "Trigger: trg_articles_updated_at"
    }
  ]

  indexes {
    (user_id, status, updated_at) [
      desc
      name: "idx_articles_user_status_updated_at_desc"
    ]
    (user_id, title) [
      unique,
      name: "uq_articles_user_title_active"
      Note: {
        "Partial: unique when title is not null and status is published / draft / private"
      }
    ]
    (user_id, slug) [
      unique,
      name: "uq_articles_user_slug_active",
      Note: {
        "Partial: unique when slug is not null and status is published / draft / private"
      }
    ]
  }
}
Ref: articles.user_id > users.id [delete: cascade]
Ref: articles.category_id > categories.id [delete: set null]

